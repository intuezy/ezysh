#!/usr/bin/env bash
# ==============================================================================
# ezysh — The aesthetic, intuitive command palette & alias launcher for your shell.
# Author: intuezy (https://github.com/intuezy)
# License: MIT
# ==============================================================================

set -euo pipefail

# ── Read-Only Constants ───────────────────────────────────────────────────────
readonly VERSION="1.7.0"
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly DEFAULTS_FILE="$SCRIPT_DIR/share/defaults.tsv"
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ezysh"
readonly DB_FILE="$CONFIG_DIR/commands.tsv"
readonly CUSTOM_FILE="$CONFIG_DIR/custom.tsv"
readonly THEME_FILE="$CONFIG_DIR/theme.sh"
readonly DEFAULT_COLORS="bg:-1,bg+:#342f4b,fg:#7f849c,fg+:#e6e6fa,hl:#f38ba8,hl+:#f38ba8,info:#7f849c,prompt:#cba6f7,pointer:#cba6f7,marker:#a6e3a1,spinner:#cba6f7,border:#342f4b,header:#7f849c"

# ── Logging Helpers ───────────────────────────────────────────────────────────
log_info() {
    echo -e "\033[1;32m⚡ ezysh:\033[0m $1"
}

log_error() {
    echo -e "\033[1;31m✖ ezysh:\033[0m $1" >&2
}

# ── Function: Render Safe Preview Card (Fast Native AWK) ──────────────────────
render_preview() {
    local line_num="${1:-0}"
    [[ "$line_num" =~ ^[0-9]+$ ]] || exit 0

    awk -F'\t' -v line="$line_num" '
    NR == line {
        cat = $1; name = $2; cmd = $3; desc = $4;
        gsub(/^\[|\]$/, "", cat)
        printf "\033[1;35m  🏷  CATEGORY\033[0m\n  \033[1;36m%s\033[0m\n\n", cat
        printf "\033[1;35m  ⚡ COMMAND\033[0m\n  \033[1;32m%s\033[0m\n\n", cmd
        printf "\033[1;34m  ℹ  DESCRIPTION\033[0m\n  \033[0;37m%s\033[0m\n\n", desc
        if (cmd ~ /<[^>]+>/) {
            printf "\033[1;33m  💡 PARAMETER INPUT\033[0m\n"
            printf "  \033[0;33mTekan Enter untuk mengisi nilai parameter\033[0m\n"
        }
        exit
    }' "$DB_FILE"
    exit 0
}

# ── Function: Fast Compiler / Database Sync ───────────────────────────────────
sync_database() {
    mkdir -p "$CONFIG_DIR"
    {
        [ -f "$DEFAULTS_FILE" ] && cat "$DEFAULTS_FILE"
        if [ -f "$CUSTOM_FILE" ]; then
            awk -F'\t' '
            /^#/ || /^$/ { next }
            NF >= 4 {
                cat = $1; name = $2; cmd = $3; desc = $4;
                gsub(/^\[|\]$/, "", cat);
                printf "[%s]\t%s\t%s\t%s\n", cat, name, cmd, desc;
                next
            }
            NF == 3 {
                name = $1; cmd = $2; rest = $3;
                if (match(rest, /^\[([^\]]+)\][ \t]*(.*)/)) {
                    sub(/^\[/, "", rest)
                    idx = index(rest, "]")
                    cat = substr(rest, 1, idx - 1)
                    desc = substr(rest, idx + 1)
                    sub(/^[ \t]+/, "", desc)
                } else {
                    cat = "Custom"; desc = rest;
                }
                printf "[%s]\t%s\t%s\t%s\n", cat, name, cmd, desc;
                next
            }
            NF == 2 {
                printf "[Custom]\t%s\t%s\t%s\n", $1, $2, $1;
                next
            }
            ' "$CUSTOM_FILE"
        fi
    } > "$DB_FILE"
}

# ── Function: Add Custom Command ──────────────────────────────────────────────
add_command() {
    local name="${1:-}"
    local cmd="${2:-}"
    local desc="${3:-}"
    local cat="${4:-Custom}"

    if [ -z "$name" ] || [ -z "$cmd" ]; then
        echo -e "\033[1;31mUsage:\033[0m ezysh --add <name> <command> <description> [category]"
        echo -e "\033[0;37mExample:\033[0m ezysh --add \"dclean\" \"docker system prune -af\" \"Bersihkan docker\" \"Docker\""
        exit 1
    fi

    [ ! -f "$CUSTOM_FILE" ] && echo "# ezysh custom commands database" > "$CUSTOM_FILE"
    echo -e "${name}\t${cmd}\t[${cat}] ${desc}" >> "$CUSTOM_FILE"
    sync_database
    log_info "Successfully added '\033[1;37m$name\033[0m' to [$cat] commands!"
    exit 0
}

# ── Function: Interactive Parameter Prompts ───────────────────────────────────
prompt_parameters() {
    local target_cmd="$1"
    if [[ ! "$target_cmd" =~ \<([^>]+)\> ]] || [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "$target_cmd"
        return
    fi

    local placeholders
    placeholders=$(echo "$target_cmd" | grep -o '<[^>]*>' | sort -u)
    for p in $placeholders; do
        local user_val=""
        echo -ne "\033[1;35m  ⚡ Enter \033[1;32m$p\033[1;35m (press Enter to skip): \033[0m" > /dev/tty
        read -r user_val < /dev/tty
        if [ -n "$user_val" ]; then
            target_cmd="${target_cmd//$p/$user_val}"
        fi
    done
    echo "$target_cmd"
}

# ── Function: Show Help ───────────────────────────────────────────────────────
show_help() {
    echo "ezysh — The aesthetic, intuitive command palette for your shell."
    echo ""
    echo "Usage: ezysh [options] [query]"
    echo ""
    echo "Tip: Type your intent (e.g. 'kill port', 'undo commit', 'clean disk') to find recipes!"
    echo ""
    echo "Options:"
    echo "  -a, --add      Quick add a new command snippet: ezysh -a <name> <cmd> <desc> [cat]"
    echo "  -s, --sync     Sync defaults and custom commands into database"
    echo "  -e, --edit     Open custom commands file for manual editing"
    echo "  -l, --list     Print all stored commands to standard output"
    echo "  -v, --version  Show version"
    echo "  -h, --help     Show this help message"
}

# ── Function: Main Interactive Palette ────────────────────────────────────────
launch_palette() {
    local initial_query="${1:-}"

    # Guard Clause: Verify fzf dependency early
    if ! command -v fzf &>/dev/null; then
        log_error "fzf is required but not installed. Please install fzf first."
        exit 1
    fi

    local fzf_colors="${EZYSH_FZF_COLORS:-$DEFAULT_COLORS}"
    local selected=""

    selected=$(awk -F'\t' '
    BEGIN { OFS="\t" }
    /^#/ || /^$/ { next }
    {
        cat = $1; name = $2; cmd = $3; desc = $4;
        display = sprintf("\033[0;35m%-12s\033[0m \033[1;37m%-24s\033[0m \033[0;90m│ %s\033[0m", cat, name, desc)
        printf "%s\t%s\t%d\t%s\t%s\n", display, cmd, NR, desc, name
    }' "$DB_FILE" | fzf \
        --ansi \
        --delimiter='\t' \
        --with-nth=1 \
        --nth=1,2,4,5 \
        --query="$initial_query" \
        --height=60% \
        --layout=reverse \
        --border=sharp \
        --border-label=" ⚡ ezysh " \
        --border-label-pos=3 \
        --prompt="   " \
        --pointer="❯" \
        --marker="●" \
        --info=inline-right \
        --color="$fzf_colors" \
        --preview="ezysh --preview-line {3}" \
        --preview-window=right:48%:wrap:border-left || true)

    # Guard Clause: User cancelled or nothing selected
    [ -z "$selected" ] && exit 0

    local raw_cmd
    raw_cmd=$(echo "$selected" | awk -F'\t' '{print $2}')
    prompt_parameters "$raw_cmd"
}

# ── Main Entrypoint Dispatcher ────────────────────────────────────────────────
main() {
    [ -r "$THEME_FILE" ] && source "$THEME_FILE"
    mkdir -p "$CONFIG_DIR"

    # Auto-sync cache if database is missing or outdated
    if [ ! -f "$DB_FILE" ] || [ "$DEFAULTS_FILE" -nt "$DB_FILE" ] || { [ -f "$CUSTOM_FILE" ] && [ "$CUSTOM_FILE" -nt "$DB_FILE" ]; }; then
        sync_database
    fi

    local action="${1:-}"
    case "$action" in
        --preview-line)
            render_preview "${2:-0}"
            ;;
        -a|--add)
            add_command "${2:-}" "${3:-}" "${4:-}" "${5:-Custom}"
            ;;
        -s|--sync)
            sync_database
            local count
            count=$(wc -l < "$DB_FILE" 2>/dev/null || echo 0)
            log_info "Successfully synced $count commands into database!"
            exit 0
            ;;
        -e|--edit)
            [ ! -f "$CUSTOM_FILE" ] && echo "# Add custom commands: Name<TAB>Command<TAB>[Category] Description" > "$CUSTOM_FILE"
            ${EDITOR:-nano} "$CUSTOM_FILE"
            sync_database
            exit 0
            ;;
        -l|--list)
            cat "$DB_FILE"
            exit 0
            ;;
        -v|--version)
            echo "ezysh v$VERSION by intuezy"
            exit 0
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            launch_palette "$action"
            ;;
    esac
}

main "$@"
