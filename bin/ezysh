# ── 11. Parse User Shell Configuration (.zshrc / .bashrc) ──
for rc in shell_rcs:
    if not os.path.exists(rc):
        continue
    with open(rc, "r", encoding="utf-8", errors="ignore") as f:
        current_cat = "General"
        for line in f:
            line = line.strip()
            if not line:
                continue
            cat_match = re.match(r"^#\s*[─\-\=]+\s*(.*?)\s*[─\-\=]+", line)
            if cat_match:
                current_cat = cat_match.group(1).strip()
                continue
            
            alias_match = re.match(r"^alias\s+([^=]+)=[\"\x27](.*?)[\"\x27](?:\s*#\s*(.*))?$", line)
            if alias_match:
                name = alias_match.group(1).strip()
                cmd = alias_match.group(2).strip()
                comment = alias_match.group(3).strip() if alias_match.group(3) else f"Alias untuk {cmd}"
                
                display_name = name
                exec_cmd = cmd
                if name in ["gco", "gsw", "gb"]:
                    if "<branch>" not in exec_cmd: exec_cmd += " <branch>"
                    display_name += " <branch>"
                elif name in ["din", "drem", "dinfo"]:
                    if "<package>" not in exec_cmd: exec_cmd += " <package>"
                    display_name += " <package>"
                elif name in ["psg", "pk"]:
                    if "<process_name>" not in exec_cmd: exec_cmd += " <process_name>"
                    display_name += " <process_name>"
                elif name in ["k9"]:
                    if "<pid>" not in exec_cmd: exec_cmd += " <pid>"
                    display_name += " <pid>"
                elif name in ["scs", "scr", "scstart", "scstop", "sce", "jl"]:
                    if "<service>" not in exec_cmd: exec_cmd += " <service>"
                    display_name += " <service>"
                elif name in ["jfu"]:
                    if "<unit>" not in exec_cmd: exec_cmd += " <unit>"
                    display_name += " <unit>"
                elif name in ["gcm"]:
                    if "<message>" not in exec_cmd: exec_cmd += ' "<message>"'
                    display_name += ' "<message>"'
                elif name in ["cat", "rm", "grs"]:
                    if "<file>" not in exec_cmd: exec_cmd += " <file>"
                    display_name += " <file>"
                elif name in ["cp", "mv"]:
                    if "<src>" not in exec_cmd: exec_cmd += " <src> <dst>"
                    display_name += " <src> <dst>"
                elif name in ["mkd"]:
                    if "<folder>" not in exec_cmd: exec_cmd += " <folder>"
                    display_name += " <folder>"
                elif name in ["untar"]:
                    if "<file.tar>" not in exec_cmd: exec_cmd += " <file.tar>"
                    display_name += " <file.tar>"
                elif name in ["ping"]:
                    if "<host>" not in exec_cmd: exec_cmd += " <host>"
                    display_name += " <host>"
                elif name in ["zja", "zjk", "zjn", "zjd"]:
                    if "<session>" not in exec_cmd: exec_cmd += " <session>"
                    display_name += " <session>"

                cat_clean = re.sub(r"^[0-9\.\s]+", "", current_cat)
                if "Git" in cat_clean: cat_clean = "Git"
                elif "Zellij" in cat_clean: cat_clean = "Zellij"
                elif "Systemd" in cat_clean: cat_clean = "Systemd"
                elif "Fedora" in cat_clean or "DNF" in cat_clean or "Package" in cat_clean or "RPM" in cat_clean or "Flatpak" in cat_clean: cat_clean = "Fedora"
                elif "COSMIC" in cat_clean or "Wayland" in cat_clean: cat_clean = "COSMIC"
                elif "Monitor" in cat_clean or "Process" in cat_clean or "Disk" in cat_clean: cat_clean = "System"
                elif "Battery" in cat_clean or "Power" in cat_clean: cat_clean = "Power"
                elif "Hardware" in cat_clean or "Sensor" in cat_clean or "Bluetooth" in cat_clean: cat_clean = "Hardware"
                elif "Recovery" in cat_clean or "Restore" in cat_clean or "Undelete" in cat_clean: cat_clean = "Recovery"
                elif "Go" in cat_clean or "Golang" in cat_clean: cat_clean = "Go"
                elif "Rust" in cat_clean or "Cargo" in cat_clean: cat_clean = "Rust"
                elif "Python" in cat_clean or "Py" in cat_clean: cat_clean = "Python"
                elif "PHP" in cat_clean or "Laravel" in cat_clean: cat_clean = "PHP"
                elif "File" in cat_clean or "Eza" in cat_clean or "Bat" in cat_clean: cat_clean = "File"
                elif "Nav" in cat_clean or "Quick" in cat_clean: cat_clean = "Nav"
                elif "Web" in cat_clean or "Dev" in cat_clean: cat_clean = "Dev"
                elif "Network" in cat_clean or "IP" in cat_clean: cat_clean = "Network"

                add_entry(cat_clean, display_name, exec_cmd, comment)

# ── 12. Append Custom User Commands from custom.tsv ──────
if os.path.exists(custom_path):
    with open(custom_path, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) == 2:
                add_entry("Custom", parts[0], parts[1], parts[0])
            elif len(parts) == 3:
                cat = "Custom"
                desc = parts[2]
                if desc.startswith("[") and "]" in desc:
                    cat = desc.split("]")[0].replace("[", "").strip()
                    desc = desc.split("]")[1].strip()
                add_entry(cat, parts[0], parts[1], desc)
            elif len(parts) >= 4:
                add_entry(parts[0], parts[1], parts[2], parts[3])

os.makedirs(ezysh_dir, exist_ok=True)
with open(db_path, "w", encoding="utf-8") as f:
    for cat, name, cmd, desc in entries:
        f.write(f"{cat}\t{name}\t{cmd}\t{desc}\n")
PYEOF
}

# ── Auto-sync if database is missing or outdated ──
SHELL_RC="$HOME/.zshrc"
[ ! -f "$SHELL_RC" ] && SHELL_RC="$HOME/.bashrc"
if [ ! -f "$DB_FILE" ] || { [ -f "$SHELL_RC" ] && [ "$SHELL_RC" -nt "$DB_FILE" ]; }; then
    sync_aliases
fi

# ── CLI Arguments Handling ────────────────────────
case "$1" in
    -a|--add)
        NAME="$2"
        CMD="$3"
        DESC="$4"
        CAT="${5:-Custom}"

        if [ -z "$NAME" ] || [ -z "$CMD" ]; then
            echo -e "\033[1;31mUsage:\033[0m ezysh --add <name> <command> <description> [category]"
            echo -e "\033[0;37mExample:\033[0m ezysh --add \"dclean\" \"docker system prune -af\" \"Bersihkan docker\" \"Docker\""
            exit 1
        fi

        [ ! -f "$CUSTOM_FILE" ] && echo "# ezysh custom commands database" > "$CUSTOM_FILE"
        echo -e "${NAME}\t${CMD}\t[${CAT}] ${DESC}" >> "$CUSTOM_FILE"
        sync_aliases
        echo -e "\033[1;32m⚡ ezysh:\033[0m Successfully added '\033[1;37m$NAME\033[0m' to [$CAT] commands!"
        exit 0
        ;;
    -s|--sync)
        sync_aliases
        count=$(wc -l < "$DB_FILE" 2>/dev/null || echo 0)
        echo "⚡ ezysh: Successfully synced $count commands into database!"
        exit 0
        ;;
    -e|--edit)
        [ ! -f "$CUSTOM_FILE" ] && echo "# Add custom commands: Name<TAB>Command<TAB>[Category] Description" > "$CUSTOM_FILE"
        ${EDITOR:-nano} "$CUSTOM_FILE"
        sync_aliases
        exit 0
        ;;
    -l|--list)
        cat "$DB_FILE"
        exit 0
        ;;
    -v|--version)
        echo "ezysh v$VERSION by intuezy"
        exit 0
        ;;
    -h|--help)
        echo "ezysh — The aesthetic, intuitive command palette for your shell."
        echo ""
        echo "Usage: ezysh [options] [query]"
        echo ""
        echo "Tip: Type 'node', 'database', 'api', 'docker', 'git', 'linux' to filter by category!"
        echo "Tip: Type 'case' to find end-to-end multi-step workflow recipes!"
        echo ""
        echo "Options:"
        echo "  -a, --add      Quick add a new command snippet: ezysh -a <name> <cmd> <desc> [cat]"
        echo "  -s, --sync     Sync aliases and curated defaults into database"
        echo "  -e, --edit     Open custom commands file for manual editing"
        echo "  -l, --list     Print all stored commands to standard output"
        echo "  -v, --version  Show version"
        echo "  -h, --help     Show this help message"
        exit 0
        ;;
esac

# Check for fzf dependency
if ! command -v fzf &>/dev/null; then
    echo "ezysh: fzf is required but not installed. Please install fzf first." >&2
    exit 1
fi

INITIAL_QUERY="$1"

# ── Interactive Aesthetic FZF Palette ─────────────
selected=$(awk -F'\t' '
BEGIN { OFS="\t" }
/^#/ || /^$/ { next }
{
    cat = $1
    name = $2
    cmd = $3
    desc = $4
    printf "\033[0;35m%-12s\033[0m \033[1;37m%s\033[0m\t%s\t%d\n", cat, name, cmd, NR
}' "$DB_FILE" | fzf \
    --ansi \
    --delimiter='\t' \
    --with-nth=1 \
    --query="$INITIAL_QUERY" \
    --height=60% \
    --layout=reverse \
    --border=sharp \
    --border-label=" ⚡ ezysh " \
    --border-label-pos=3 \
    --prompt="   " \
    --pointer="❯" \
    --marker="●" \
    --info=inline-right \
    --color="bg:-1,bg+:#342f4b,fg:#7f849c,fg+:#e6e6fa,hl:#f38ba8,hl+:#f38ba8,info:#7f849c,prompt:#cba6f7,pointer:#cba6f7,marker:#a6e3a1,spinner:#cba6f7,border:#342f4b,header:#7f849c" \
    --preview="ezysh --preview-line {3}" \
    --preview-window=right:48%:wrap:border-left)

if [ -z "$selected" ]; then
    exit 0
fi

# Extract execution command (column 2 in tab delimiter)
cmd=$(echo "$selected" | awk -F'\t' '{print $2}')

# ── Interactive Parameter Replacement ─────────────
if [[ "$cmd" =~ \<([^>]+)\> ]] && [ -t 0 ] && [ -t 1 ]; then
    placeholders=$(echo "$cmd" | grep -o '<[^>]*>' | sort -u)
    for p in $placeholders; do
        param_clean="${p:1:-1}"
        echo -ne "\033[1;35m  ⚡ Enter \033[1;32m$p\033[1;35m (press Enter to skip): \033[0m" > /dev/tty
        read -r user_val < /dev/tty
        if [ -n "$user_val" ]; then
            cmd="${cmd//$p/$user_val}"
        fi
    done
fi

echo "$cmd"
