#!/usr/bin/env bash
# ==============================================================================
# ezysh — The aesthetic, intuitive command palette & alias launcher for your shell.
# Author: intuezy (https://github.com/intuezy)
# License: MIT
# ==============================================================================

VERSION="1.3.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ezysh"
DB_FILE="$CONFIG_DIR/commands.tsv"
CUSTOM_FILE="$CONFIG_DIR/custom.tsv"

mkdir -p "$CONFIG_DIR"

# ── Built-in Curated Defaults & Shell Sync ────────
sync_aliases() {
    python3 - << 'PYEOF'
import re, os

home = os.path.expanduser("~")
config_dir = os.environ.get("XDG_CONFIG_HOME", os.path.join(home, ".config"))
ezysh_dir = os.path.join(config_dir, "ezysh")
db_path = os.path.join(ezysh_dir, "commands.tsv")
custom_path = os.path.join(ezysh_dir, "custom.tsv")

shell_rcs = [
    os.path.join(home, ".zshrc"),
    os.path.join(home, ".bashrc"),
    os.path.join(config_dir, "fish", "config.fish")
]

entries = []
seen_commands = set()

def add_entry(cat, name, cmd, desc):
    key = f"{cat}:{name}"
    if key not in seen_commands:
        seen_commands.add(key)
        clean_cat = cat if cat.startswith("[") else f"[{cat}]"
        entries.append((clean_cat, name, cmd, desc))

# ── 1. Curated Gold-Standard Defaults: [Network] Suite ──
network_defaults = [
    # ── Real-World Case & Pipeline Combinations ──
    ("case-kill-port <port>", "kill -9 $(lsof -t -i :<port>)", "CASE: Otomatis cari PID & paksa matikan proses yang pakai port"),
    ("case-top-connected-ips", "ss -ntu | awk '{print $5}' | cut -d: -f1 | sort | uniq -c | sort -nr | head -n 10", "CASE: Deteksi Top 10 IP koneksi terbanyak ke server (Investigasi DDoS/Traffic)"),
    ("case-dns-compare-resolvers <domain>", "for dns in 1.1.1.1 8.8.8.8 9.9.9.9 208.67.222.222; do echo -ne \"DNS $dns: \\t\"; dig @$dns +short <domain> | tr '\\n' ' '; echo \"\"; done", "CASE: Uji propagasi DNS ke 4 provider publik (Cloudflare, Google, Quad9, OpenDNS)"),
    ("case-check-ssl-days-left <domain>", "echo | openssl s_client -servername <domain> -connect <domain>:443 2>/dev/null | openssl x509 -noout -enddate -checkend 2592000 && echo \"✅ SSL Valid > 30 hari\" || echo \"⚠️ SSL Expiring Soon / Invalid\"", "CASE: Cek masa berlaku SSL apakah masih aman > 30 hari"),
    ("case-watch-port <port>", "watch -n 1 \"ss -tulpn | grep :<port>\"", "CASE: Live monitor status port & koneksi setiap 1 detik"),
    ("case-api-benchmark-10x <url>", "for i in {1..10}; do curl -s -o /dev/null -w \"Run $i: Status %{http_code} | Total: %{time_total}s (TTFB: %{time_starttransfer}s)\\n\" <url>; done", "CASE: Benchmark latency endpoint API 10 kali berturut-turut"),
    ("case-sniff-http-requests <port>", "sudo tcpdump -s 0 -A -l -i any \"tcp port <port>\" | grep -E --line-buffered \"^(GET|POST|PUT|DELETE|PATCH|HEAD) \"", "CASE: Sniff & filter khusus baris request HTTP di port tertentu"),
    ("case-scan-wifi-live-hosts", "nmap -sn $(ip -o -f inet addr show | awk '/scope global/ {print $4}' | head -n 1)", "CASE: Auto-scan seluruh IP perangkat yang aktif di subnet WiFi lokal"),
    ("case-download-extract-tar <url>", "curl -sL <url> | tar -xz", "CASE: Download dan langsung ekstrak arsip tar.gz tanpa simpan file .tar"),
    ("case-ssh-background-tunnel <local_port> <remote_port> <user@host>", "ssh -f -N -L <local_port>:localhost:<remote_port> <user@host>", "CASE: Buka SSH Tunnel di background (daemon) tanpa tahan terminal"),
    ("case-find-public-interface", "ip route get 1.1.1.1 | awk '{print \"Interface:\", $5, \"| Local IP:\", $7}'", "CASE: Cari nama kartu interface & IP lokal yang routing ke internet"),

    # ── Port & Process Inspection ──
    ("port-who <port>", "lsof -i :<port>", "Cek aplikasi / PID apa yang sedang memakai port tertentu"),
    ("port-kill <port>", "fuser -k <port>/tcp", "Paksa matikan proses yang menduduki port tertentu"),
    ("ports-listen", "ss -tulwn", "List semua port TCP/UDP lokal yang aktif & listening"),
    ("ports-established", "ss -t state established", "List semua koneksi TCP yang sedang aktif (Established)"),
    ("port-check <host> <port>", "nc -zv <host> <port>", "Uji apakah port remote di server terbuka / bisa diakses"),
    
    # ── DNS & Domain Diagnostics ──
    ("dns-records <domain>", "dig <domain> ANY +noall +answer", "Cek semua record DNS domain (A, MX, TXT, NS, CNAME)"),
    ("dns-trace <domain>", "dig +trace <domain>", "Lacak rantai resolusi DNS dari root server hingga authoritative"),
    ("dns-ip <domain>", "dig +short <domain>", "Ambil hanya IP address publik dari suatu domain secara cepat"),
    ("dns-reverse <ip>", "dig -x <ip> +short", "Reverse DNS: Cari nama domain asal dari sebuah IP address"),
    ("whois-domain <domain>", "whois <domain>", "Cek informasi kepemilikan dan registrar domain"),
    ("dns-flush-cache", "sudo systemd-resolve --flush-caches || sudo resolvectl flush-caches", "Flush / bersihkan cache DNS lokal komputer"),

    # ── SSL / TLS Certificate ──
    ("ssl-expiry <domain>", "openssl s_client -connect <domain>:443 -servername <domain> 2>/dev/null | openssl x509 -noout -dates -subject", "Cek tanggal kadaluarsa & subjek sertifikat SSL"),
    ("ssl-chain <domain>", "openssl s_client -showcerts -connect <domain>:443", "Tampilkan sertifikat SSL lengkap beserta rantai CA chain"),

    # ── HTTP & API Debugging ──
    ("http-timing <url>", 'curl -s -o /dev/null -w "DNS: %{time_namelookup}s | Connect: %{time_connect}s | TTFB: %{time_starttransfer}s | Total: %{time_total}s\n" <url>', "Ukur rincian latency HTTP (DNS, TCP, TTFB, Total)"),
    ("http-headers <url>", "curl -ILs <url>", "Ambil header HTTP lengkap dan ikuti redirect (301/302)"),
    ("http-post-json <url> <json>", "curl -X POST -H \"Content-Type: application/json\" -d '<json>' <url>", "Kirim request HTTP POST dengan payload JSON"),
    ("http-auth-bearer <url> <token>", "curl -H \"Authorization: Bearer <token>\" <url>", "Kirim request HTTP dengan Authorization Bearer Token"),
    ("http-download-resume <url>", "curl -C - -O <url>", "Download file besar dengan kemampuan resume jika terputus"),

    # ── Traffic Sniffing & Bandwidth ──
    ("sniff-port <port>", "sudo tcpdump -i any port <port> -n -s 0 -X", "Sniff & dump isi paket data mentah pada port tertentu"),
    ("sniff-host <host>", "sudo tcpdump -i any host <host> -n", "Sniff seluruh lalu lintas paket menuju / dari host tertentu"),
    ("bandwidth-process", "sudo nethogs", "Monitor pemakaian bandwidth jaringan per proses / PID realtime"),
    ("bandwidth-live", "sudo iftop", "Monitor traffic bandwidth antar IP realtime"),
    ("speed-test", "curl -s https://raw.githubusercontent.com/sivel/speedtest-cli/master/speedtest.py | python3 -", "Uji kecepatan internet (Speedtest) langsung di terminal"),

    # ── SSH Tunneling & Port Forwarding ──
    ("ssh-forward-local <local_port> <remote_port> <user@host>", "ssh -L <local_port>:localhost:<remote_port> <user@host> -N", "Buka port database remote di localhost laptop via SSH tunnel"),
    ("ssh-reverse-tunnel <remote_port> <local_port> <user@host>", "ssh -R <remote_port>:localhost:<local_port> <user@host> -N", "Expose server lokal ke VPS publik via Reverse SSH Tunnel"),
    ("ssh-socks-proxy <port> <user@host>", "ssh -D <port> -q -C -N <user@host>", "Buat proxy SOCKS5 aman melalui server SSH"),
    ("ssh-copy-key <user@host>", "ssh-copy-id <user@host>", "Salin public key SSH ke remote server agar login tanpa password"),

    # ── IP, Routing & LAN Discovery ──
    ("my-ip-public", "curl -s ifconfig.me && echo", "Cek alamat IP publik internet saat ini"),
    ("my-ip-detail <ip>", "curl -s ipinfo.io/<ip>", "Cek detail geolokasi, kota, ISP, dan ASN dari IP address"),
    ("ip-lan-devices", "ip neigh", "List perangkat lain yang aktif di jaringan lokal / WiFi (ARP table)"),
    ("ip-subnet-scan <subnet>", "nmap -sn <subnet>", "Scan seluruh host / IP aktif dalam satu subnet (cth: 192.168.1.0/24)"),
    ("ip-route-table", "ip route show", "Tampilkan routing table & IP gateway router default"),
    ("ip-interface-stats", "ip -s link", "Cek statistik interface jaringan (packet drop / RX-TX errors)"),

    # ── Firewall Management ──
    ("firewall-status", "sudo firewall-cmd --list-all 2>/dev/null || sudo ufw status verbose", "Cek status firewall & daftar port yang sedang terbuka"),
    ("firewall-open <port>", "sudo firewall-cmd --add-port=<port>/tcp --permanent && sudo firewall-cmd --reload", "Buka port TCP pada firewall Fedora / RHEL"),
    ("firewall-ufw-open <port>", "sudo ufw allow <port>/tcp", "Buka port TCP pada firewall UFW (Ubuntu / Debian)"),

    # ── Connectivity & Latency ──
    ("trace-route <host>", "traceroute <host>", "Lacak rute hop perjalanan paket jaringan menuju target"),
    ("ping-test <host>", "ping -c 5 <host>", "Tes latency & stabilitas koneksi (dibatasi 5 paket)"),
    ("ping-mtu-check <packet_size> <host>", "ping -M do -s <packet_size> <host>", "Tes ukuran MTU tanpa fragmentasi (cth: 1472)"),
    ("wifi-networks", "nmcli dev wifi list", "Scan dan list semua sinyal WiFi di sekitar"),
]

for name, cmd, desc in network_defaults:
    add_entry("Network", name, cmd, desc)

# ── 2. Parse User Shell Configuration (.zshrc / .bashrc) ──
for rc in shell_rcs:
    if not os.path.exists(rc):
        continue
    with open(rc, "r", encoding="utf-8", errors="ignore") as f:
        current_cat = "General"
        for line in f:
            line = line.strip()
            if not line:
                continue
            cat_match = re.match(r"^#\s*[─\-\=]+\s*(.*?)\s*[─\-\=]+", line)
            if cat_match:
                current_cat = cat_match.group(1).strip()
                continue
            
            alias_match = re.match(r"^alias\s+([^=]+)=[\"\x27](.*?)[\"\x27](?:\s*#\s*(.*))?$", line)
            if alias_match:
                name = alias_match.group(1).strip()
                cmd = alias_match.group(2).strip()
                comment = alias_match.group(3).strip() if alias_match.group(3) else f"Alias untuk {cmd}"
                
                # Smart annotation for interactive parameter replacement
                display_name = name
                exec_cmd = cmd
                if name in ["gco", "gsw", "gb"]:
                    if "<branch>" not in exec_cmd: exec_cmd += " <branch>"
                    display_name += " <branch>"
                elif name in ["din", "drem", "dinfo"]:
                    if "<package>" not in exec_cmd: exec_cmd += " <package>"
                    display_name += " <package>"
                elif name in ["psg", "pk"]:
                    if "<process_name>" not in exec_cmd: exec_cmd += " <process_name>"
                    display_name += " <process_name>"
                elif name in ["k9"]:
                    if "<pid>" not in exec_cmd: exec_cmd += " <pid>"
                    display_name += " <pid>"
                elif name in ["scs", "scr", "scstart", "scstop", "sce", "jl"]:
                    if "<service>" not in exec_cmd: exec_cmd += " <service>"
                    display_name += " <service>"
                elif name in ["jfu"]:
                    if "<unit>" not in exec_cmd: exec_cmd += " <unit>"
                    display_name += " <unit>"
                elif name in ["gcm"]:
                    if "<message>" not in exec_cmd: exec_cmd += ' "<message>"'
                    display_name += ' "<message>"'
                elif name in ["cat", "rm", "grs"]:
                    if "<file>" not in exec_cmd: exec_cmd += " <file>"
                    display_name += " <file>"
                elif name in ["cp", "mv"]:
                    if "<src>" not in exec_cmd: exec_cmd += " <src> <dst>"
                    display_name += " <src> <dst>"
                elif name in ["mkd"]:
                    if "<folder>" not in exec_cmd: exec_cmd += " <folder>"
                    display_name += " <folder>"
                elif name in ["untar"]:
                    if "<file.tar>" not in exec_cmd: exec_cmd += " <file.tar>"
                    display_name += " <file.tar>"
                elif name in ["ping"]:
                    if "<host>" not in exec_cmd: exec_cmd += " <host>"
                    display_name += " <host>"
                elif name in ["zja", "zjk", "zjn", "zjd"]:
                    if "<session>" not in exec_cmd: exec_cmd += " <session>"
                    display_name += " <session>"

                cat_clean = re.sub(r"^[0-9\.\s]+", "", current_cat)
                if "Git" in cat_clean: cat_clean = "Git"
                elif "Zellij" in cat_clean: cat_clean = "Zellij"
                elif "Systemd" in cat_clean: cat_clean = "Systemd"
                elif "DNF" in cat_clean or "Package" in cat_clean: cat_clean = "Package"
                elif "Monitor" in cat_clean or "Process" in cat_clean or "Disk" in cat_clean: cat_clean = "System"
                elif "File" in cat_clean or "Eza" in cat_clean or "Bat" in cat_clean: cat_clean = "File"
                elif "Nav" in cat_clean or "Quick" in cat_clean: cat_clean = "Nav"
                elif "Web" in cat_clean or "Dev" in cat_clean: cat_clean = "Dev"
                elif "Network" in cat_clean or "IP" in cat_clean: cat_clean = "Network"

                add_entry(cat_clean, display_name, exec_cmd, comment)

# ── 3. Append Custom User Commands from custom.tsv ──────
if os.path.exists(custom_path):
    with open(custom_path, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) == 2:
                add_entry("Custom", parts[0], parts[1], parts[0])
            elif len(parts) == 3:
                cat = "Custom"
                desc = parts[2]
                if desc.startswith("[") and "]" in desc:
                    cat = desc.split("]")[0].replace("[", "").strip()
                    desc = desc.split("]")[1].strip()
                add_entry(cat, parts[0], parts[1], desc)
            elif len(parts) >= 4:
                add_entry(parts[0], parts[1], parts[2], parts[3])

os.makedirs(ezysh_dir, exist_ok=True)
with open(db_path, "w", encoding="utf-8") as f:
    for cat, name, cmd, desc in entries:
        f.write(f"{cat}\t{name}\t{cmd}\t{desc}\n")
PYEOF
}

# ── Auto-sync if database is missing or outdated ──
SHELL_RC="$HOME/.zshrc"
[ ! -f "$SHELL_RC" ] && SHELL_RC="$HOME/.bashrc"
if [ ! -f "$DB_FILE" ] || { [ -f "$SHELL_RC" ] && [ "$SHELL_RC" -nt "$DB_FILE" ]; }; then
    sync_aliases
fi

# ── CLI Arguments Handling ────────────────────────
case "$1" in
    -s|--sync)
        sync_aliases
        count=$(wc -l < "$DB_FILE" 2>/dev/null || echo 0)
        echo "⚡ ezysh: Successfully synced $count commands into database!"
        exit 0
        ;;
    -e|--edit)
        [ ! -f "$CUSTOM_FILE" ] && echo "# Add custom commands: Name<TAB>Command<TAB>[Category] Description" > "$CUSTOM_FILE"
        ${EDITOR:-nano} "$CUSTOM_FILE"
        sync_aliases
        exit 0
        ;;
    -l|--list)
        cat "$DB_FILE"
        exit 0
        ;;
    -v|--version)
        echo "ezysh v$VERSION by intuezy"
        exit 0
        ;;
    -h|--help)
        echo "ezysh — The aesthetic, intuitive command palette for your shell."
        echo ""
        echo "Usage: ezysh [options] [query]"
        echo ""
        echo "Tip: Type 'network', 'git', 'docker', 'sys' to filter by category!"
        echo "Tip: Type 'case' to find end-to-end multi-step workflow recipes!"
        echo ""
        echo "Options:"
        echo "  -s, --sync     Sync aliases and curated defaults into database"
        echo "  -e, --edit     Open custom commands file for manual editing"
        echo "  -l, --list     Print all stored commands to standard output"
        echo "  -v, --version  Show version"
        echo "  -h, --help     Show this help message"
        exit 0
        ;;
esac

# Check for fzf dependency
if ! command -v fzf &>/dev/null; then
    echo "ezysh: fzf is required but not installed. Please install fzf first." >&2
    exit 1
fi

INITIAL_QUERY="$1"

# ── Interactive Category-First FZF Palette ────────
selected=$(awk -F'\t' '
BEGIN { OFS="\t" }
/^#/ || /^$/ { next }
{
    cat = $1
    name = $2
    cmd = $3
    desc = $4
    printf "%-12s \033[1;37m%-35s\033[0m │ \033[0;37m%s\033[0m\t%s\t%s\t%s\n", cat, name, desc, cmd, cat, desc
}' "$DB_FILE" | fzf \
    --ansi \
    --delimiter='\t' \
    --with-nth=1 \
    --query="$INITIAL_QUERY" \
    --height=60% \
    --layout=reverse \
    --border=sharp \
    --border-label=" ⚡ ezysh — Command Palette " \
    --border-label-pos=3 \
    --prompt="   " \
    --pointer="❯" \
    --marker="●" \
    --color="bg:-1,bg+:#342f4b,fg:#7f849c,fg+:#e6e6fa,hl:#f38ba8,hl+:#f38ba8,info:#7f849c,prompt:#cba6f7,pointer:#cba6f7,marker:#a6e3a1,spinner:#cba6f7,border:#342f4b,header:#7f849c" \
    --header=" [ Tip: Ketik 'network', 'case', 'git', 'sys' untuk filter instan ] " \
    --preview="echo -e '\n\033[1;35m  🏷  Category:\033[0m  \033[1;36m{3}\033[0m\n\n\033[1;35m  ⚡ Command:\033[0m\n  \033[1;32m{2}\033[0m\n\n\033[1;34m  ℹ  Description:\033[0m\n  \033[0;37m{4}\033[0m'" \
    --preview-window=right:44%:wrap)

if [ -z "$selected" ]; then
    exit 0
fi

# Extract execution command (column 2 in tab delimiter)
cmd=$(echo "$selected" | awk -F'\t' '{print $2}')

# ── Interactive Parameter Replacement ─────────────
if [[ "$cmd" =~ \<([^>]+)\> ]] && [ -t 0 ] && [ -t 1 ]; then
    placeholders=$(echo "$cmd" | grep -o '<[^>]*>' | sort -u)
    for p in $placeholders; do
        param_clean="${p:1:-1}"
        echo -ne "\033[1;35m  ⚡ Enter \033[1;32m$p\033[1;35m (press Enter to skip): \033[0m" > /dev/tty
        read -r user_val < /dev/tty
        if [ -n "$user_val" ]; then
            cmd="${cmd//$p/$user_val}"
        fi
    done
fi

echo "$cmd"
