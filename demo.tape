Output assets/demo.gif

Set FontSize 15
Set Width 1050
Set Height 600
Set Padding 15
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set TypingSpeed 60ms

Hide
Type "source ~/.bashrc"
Enter
Type "clear"
Enter
Show

Sleep 800ms

# Launch palette
Type "ezy"
Sleep 500ms
Enter

Sleep 1s

# Type intent: kill port
Type "kill port"
Sleep 1.5s
Enter

# Fill parameter: 3000
Sleep 1s
Type "3000"
Sleep 500ms
Enter

Sleep 2s

# Clear and show next intent: undo commit
Type "clear"
Enter
Sleep 800ms

Type "ezy"
Sleep 500ms
Enter

Sleep 1s
Type "undo commit"
Sleep 1.5s
Enter

Sleep 2s
